# Local Android captures. These often contain phone numbers, account names,
# Wi-Fi identifiers, app package state, device serials, crash contents, and paths.
captures/
backups/
recovery_profile/
recovery-profile.tar.gpg
credentials.txt
restore_payloads/
*_dumps/
analysis_kernel_logs/

# Bugreports and extracted kernel/recovery artifacts.
bugreport*.zip
bugreport*.txt
dumpstate*.zip
dumpstate*.txt
dumpstate*.log
*.lst
*.p
*.html

# Common adb/logcat/dumpsys outputs.
#
# collect_android_dumps.sh writes dumpsys output as `dumpsys_<service>.txt`, so
# bare names like `wifi.txt` never matched anything. Every capture also gets a
# sibling `<name>.stderr`.
logcat*.txt
dropbox_*.txt
getprop.txt
dumpsys_*.txt
batterystats*.txt
*.stderr

# Photo discovery output. These hold the full device path of every photo and
# video on the phone -- filenames, folder names, app names and dates -- which is
# personal data under the same rule as the captures themselves.
photos_index.txt
photos_report.txt
missing_photos.txt
photos/
last_kmsg*
last_kernel*
last_all_history*

# Archives and raw device dumps.
*.zip
*.gz
*.tar
*.tgz
*.7z
*.img
*.bin
*.dmp
*.dump

# Local editor/tool state.
.agents/
scripts/script-helpers/
scripts/ci-helpers/
.idea/
.vscode/
*.swp
*~

# OS noise.
.DS_Store
Thumbs.db

# Public capture configuration.
#
# `!config/` alone does not rescue a file whose name matches a broad rule above
# (*.lst, *.p). `!config/**` does, and config/ is documented as user-editable.
!config/
!config/**

# GitHub Pages source assets. Keep raw captured HTML ignored.
#
# `*.html` above is meant for captured bugreport HTML, but it also swallowed any
# new page under docs/. Rescue the whole docs tree rather than one file at a time.
!docs/**/*.html
!docs/assets/
!docs/assets/site.css
