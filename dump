#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<EOF
Usage:
  ./dump log [destination]
  ./dump data [destination] [--recovery-profile]

Commands:
  log   Collect Android diagnostic logs and build a triage report.
  data  Preserve personal/shared data using the interactive backup flow.
        Add --recovery-profile for settings, networks, and owner-exported credentials.

Examples:
  ./dump log
  ./dump log /mnt/android-dumps/s22-reboot-loop
  ./dump data
  ./dump data /mnt/android-backups/s22-before-reset
  ./dump data /mnt/android-backups/s22-before-reset --recovery-profile
EOF
}

mode="${1:-}"
if [ -n "$mode" ]; then
  shift
fi

case "$mode" in
  log)
    destination="${1:-captures/$(date +%Y%m%d-%H%M%S)}"
    "$ROOT/tools/collect_android_dumps.sh" "$destination"
    "$ROOT/tools/analyze_android_capture.sh" "$destination"
    printf 'Diagnostic capture: %s\n' "$destination"
    printf 'Triage report: %s/analysis_report.txt\n' "$destination"
    ;;
  data)
    # ${1+"$@"} rather than "$@": on bash 3.2, which is what macOS ships,
    # "$@" with no positional parameters is an unbound-variable error under
    # `set -u`, so the documented bare `./dump data` died before starting.
    "$ROOT/tools/android_backup_dialog.sh" ${1+"$@"}
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$mode" >&2
    usage >&2
    exit 1
    ;;
esac
